---
# Ansible Tower / AAP — Vault Variables Example
#
# Copy to group_vars/all/vault.yml and encrypt:
#   ansible-vault create group_vars/all/vault.yml

# ---- Automation Controller ---------------------------------------------------
# The account used to APPLY the controller configuration. It needs permission to
# manage the objects declared in ansible_tower/vars/, and nothing more.
vault_aap_username: "admin"
vault_aap_password: "CHANGE_ME"

# ---- Credentials the controller will hold ------------------------------------
# Secrets that end up INSIDE the controller's own credential store, so that an
# operator can launch a job template without ever seeing them. Supply them under
# the `inputs` key of an entry in aap_credentials; that key is never written to
# a plan artifact, and the task that applies it runs under no_log.
vault_ise_password: "CHANGE_ME"
vault_nios_password: "CHANGE_ME"
