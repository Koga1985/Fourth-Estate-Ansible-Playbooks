# Example ansible.cfg for running these playbooks with the fe_validation
# callback enabled. Copy to ansible.cfg (or merge into your own) -- it is not
# committed as ansible.cfg so it cannot silently change how the repo behaves.
#
# The callback records per-component status, timing and failure detail with no
# in-play tasks. It does NOT replace ansible.builtin.set_stats: only set_stats
# feeds AWX/AAP job artifacts and workflow variables.
# See docs/VALIDATION_AND_STATS.md.
[defaults]
callback_plugins = ./callback_plugins
callbacks_enabled = fe_validation
show_custom_stats = True

[callback_fe_validation]
output_path = fe_validation_report.json
show_summary = true
include_harness_tasks = false
